# Azure App Registration client ID — see README.md "Register an Azure app" section.
# (Well-known Microsoft public client IDs don't work here: Microsoft's anti-phishing
# protections block/flag device-code sign-in with high-trust client IDs on personal
# accounts, so this has to be an app you register yourself.)
AZURE_CLIENT_ID=

AZURE_AUTHORITY=https://login.microsoftonline.com/common

# The two links you shared. Keep them quoted since they contain special characters.
ONEDRIVE_EXCEL_URL="https://1drv.ms/x/REPLACE_WITH_YOUR_WORKBOOK_SHARE_LINK"
ONEDRIVE_FILES_FOLDER_URL="https://1drv.ms/f/REPLACE_WITH_YOUR_RECEIPTS_FOLDER_SHARE_LINK"
