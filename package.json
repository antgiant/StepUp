{
  "name": "step-up-helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "browser": "tsx packages/cli/src/browserServer.ts",
    "discover": "tsx packages/cli/src/discover.ts",
    "inspect": "tsx packages/cli/src/inspectPages.ts",
    "start": "tsx packages/cli/src/main.ts",
    "plan": "tsx packages/cli/src/planReimbursements.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "import-legacy": "tsx packages/cli/src/importLegacy.ts",
    "year": "tsx packages/cli/src/year.ts",
    "ingest": "tsx packages/cli/src/ingest.ts",
    "report": "tsx packages/cli/src/report.ts",
    "verify": "tsx packages/cli/src/verify.ts",
    "backup": "tsx packages/cli/src/backup.ts",
    "reference:build": "tsx packages/cli/src/referenceBuild.ts",
    "reference:promote": "tsx packages/cli/src/referenceBuild.ts promote",
    "reference:validate": "tsx packages/cli/src/referenceBuild.ts validate"
  },
  "license": "ISC",
  "devDependencies": {
    "fast-check": "^4.10.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
